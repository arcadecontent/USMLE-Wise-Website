RewriteEngine On
Options -MultiViews
DirectoryIndex index.php

# --- 1. 301 redirects: legacy .html URLs -> extensionless PHP routes ---
RewriteRule ^index\.html$ / [R=301,L]
RewriteRule ^coaching\.html$ /coaching [R=301,L]
RewriteRule ^coaching-step1-crash-course\.html$ /coaching-step1-crash-course [R=301,L]
RewriteRule ^coaching-step1-mastery\.html$ /coaching-step1-mastery [R=301,L]
RewriteRule ^coaching-step1-review\.html$ /coaching-step1-review [R=301,L]
RewriteRule ^coaching-step23-mastery\.html$ /coaching-step23-mastery [R=301,L]
RewriteRule ^coaching-tutoring\.html$ /coaching-tutoring [R=301,L]
RewriteRule ^match\.html$ /match [R=301,L]
RewriteRule ^match-lor\.html$ /match-lor [R=301,L]
RewriteRule ^match-eras-cv\.html$ /match-eras-cv [R=301,L]
RewriteRule ^match-ps3x\.html$ /match-ps3x [R=301,L]
RewriteRule ^match-interview\.html$ /match-interview [R=301,L]
RewriteRule ^research\.html$ /research [R=301,L]
RewriteRule ^research-catalyst\.html$ /research-catalyst [R=301,L]
RewriteRule ^research-original\.html$ /research-original [R=301,L]
RewriteRule ^research-review\.html$ /research-review [R=301,L]
RewriteRule ^research-masterclass\.html$ /research-masterclass [R=301,L]
RewriteRule ^research-junior-scientist\.html$ /research-junior-scientist [R=301,L]
RewriteRule ^rotations\.html$ /rotations [R=301,L]
RewriteRule ^clinical-rotations\.html$ /clinical-rotations [R=301,L]
RewriteRule ^rotation-(.+)\.html$ /rotation-$1 [R=301,L]
RewriteRule ^testimonials\.html$ /testimonials [R=301,L]
RewriteRule ^qa\.html$ /qa [R=301,L]
RewriteRule ^policy\.html$ /policy [R=301,L]
RewriteRule ^case-study-ahmed\.html$ /case-study-ahmed [R=301,L]

# --- 1b. 301 redirects: legacy WordPress (old site) URLs -> new pages ---
# NOTE: where an old slug is identical to a new slug (research-catalyst,
# clinical-rotations) only the trailing-slash form is redirected, otherwise
# the clean URL would 301 to itself and loop.

# Coaching
RewriteRule ^crash-course/?$ /coaching-step1-crash-course [R=301,L]
RewriteRule ^crash-course-step-1/?$ /coaching-step1-crash-course [R=301,L]
RewriteRule ^step-1-high-yield-crash-course/?$ /coaching-step1-crash-course [R=301,L]
RewriteRule ^step-1-course/?$ /coaching-step1-mastery [R=301,L]
RewriteRule ^usmle-step-2-crash-course/?$ /coaching-step23-mastery [R=301,L]
RewriteRule ^usmle-step-exam-readiness/?$ /coaching [R=301,L]
RewriteRule ^usmle-exam-n-1-coaching/?$ /coaching [R=301,L]
RewriteRule ^usmlewise-60-minute-strategy-session/?$ /coaching [R=301,L]
RewriteRule ^book-your-free-stratergy-call/?$ /coaching [R=301,L]
RewriteRule ^guidance-call/?$ /coaching [R=301,L]
RewriteRule ^usmlewise-hybrid-mentorship-program/?$ /coaching [R=301,L]
RewriteRule ^(eb-all-courses|eb-courses|eb-my-courses|eb-single-course|my-courses-new)/?$ /coaching [R=301,L]

# Research
RewriteRule ^research-catalyst/$ /research-catalyst [R=301,L]
RewriteRule ^usmle-xponential-catalyst/?$ /research-catalyst [R=301,L]
RewriteRule ^usmle-xponential-catalyst-premium-package/?$ /research-catalyst [R=301,L]
RewriteRule ^xponential-advantage/?$ /research-catalyst [R=301,L]
RewriteRule ^rc-level-1/?$ /research-catalyst [R=301,L]
RewriteRule ^acc-research/?$ /research [R=301,L]
RewriteRule ^research-programs/?$ /research [R=301,L]
RewriteRule ^research-course/?$ /research-masterclass [R=301,L]
RewriteRule ^cdc-wonder-masterclass/?$ /research-masterclass [R=301,L]
RewriteRule ^guided-research-program/?$ /research-junior-scientist [R=301,L]
RewriteRule ^letter-to-editor-series/?$ /research-review [R=301,L]
RewriteRule ^fastrack-narrative/?$ /research-review [R=301,L]
RewriteRule ^ma/?$ /research-review [R=301,L]
RewriteRule ^(polio-project|post-webinar-polio|research-webinar-polio)/?$ /research [R=301,L]

# Match
RewriteRule ^match-package/?$ /match [R=301,L]
RewriteRule ^lor/?$ /match-lor [R=301,L]
RewriteRule ^eras-cv/?$ /match-eras-cv [R=301,L]
RewriteRule ^eras-cv-feedback/?$ /match-eras-cv [R=301,L]
RewriteRule ^personal-statement/?$ /match-ps3x [R=301,L]
RewriteRule ^ps3x-masterclass/?$ /match-ps3x [R=301,L]
RewriteRule ^ps-masterclass/?$ /match-ps3x [R=301,L]
RewriteRule ^ps-chechlist/?$ /match-ps3x [R=301,L]
RewriteRule ^(interview-preparation|interview-prep-2|interview-buddy|interview-prep-post-webinar|buddy)/?$ /match-interview [R=301,L]

# Rotations
RewriteRule ^clinical-rotations/$ /clinical-rotations [R=301,L]
RewriteRule ^available-rotations/?$ /clinical-rotations [R=301,L]

# Social proof
RewriteRule ^clients/?$ /testimonials [R=301,L]
RewriteRule ^clients-2/?$ /testimonials [R=301,L]

# Legal
RewriteRule ^cookie-policy/?$ /policy [R=301,L]
RewriteRule ^privacy-policy-2/?$ /policy [R=301,L]
RewriteRule ^terms-of-service/?$ /policy [R=301,L]

# Marketing / account / tools / webinars / confirmations -> home
RewriteRule ^(about|blog-home|free-resources|services-offered|contact|csv-converter|track-your-usmle-study-progress-daily|divine-intervention|draft-29|user-account|user-account-new)/?$ / [R=301,L]
RewriteRule ^(medical-school-webinar|webinar|webinar-2|webinars|step-2-webinar|step-2-webinar-dr-manik)/?$ / [R=301,L]
RewriteRule ^(unsubscribe|unsubscribe-2|thank-you-for-purchase)/?$ / [R=301,L]
RewriteRule ^payment-confirmation.*$ / [R=301,L]

# --- 1c. Additional legacy WordPress pages (from full DB audit) ---
# Coaching
RewriteRule ^step-1-crash-course/?$ /coaching-step1-crash-course [R=301,L]
RewriteRule ^(crash-course-test|manik-test-crash-course)/?$ /coaching-step1-crash-course [R=301,L]
RewriteRule ^step-2-crash-course/?$ /coaching-step23-mastery [R=301,L]
RewriteRule ^(usmle-mastery|usmle-step-1-mastery)/?$ /coaching-step1-mastery [R=301,L]
RewriteRule ^(online-courses|online-courses-2|enroll)/?$ /coaching [R=301,L]

# Research
RewriteRule ^junior-scientist-program/?$ /research-junior-scientist [R=301,L]
RewriteRule ^(beginner-research|research-workshop-beginner)/?$ /research-masterclass [R=301,L]
RewriteRule ^narrative-review-cohort-1/?$ /research-review [R=301,L]
RewriteRule ^(rapid-research|rapid-research-for-the-match|rapid-research-masterclass|match-worthy-research|crist-project|polio-project-2|signature-scholar-program|webinar-research)/?$ /research [R=301,L]

# Match
RewriteRule ^(cv-building|webinar-how-to-craft-a-match-worthy-cv)/?$ /match-eras-cv [R=301,L]
RewriteRule ^(soap-support|match-membership|match-membership-2|membership-match)/?$ /match [R=301,L]
RewriteRule ^observers-edge/?$ /clinical-rotations [R=301,L]

# Social proof / legal
RewriteRule ^case-report-dr-kaushik/?$ /testimonials [R=301,L]
RewriteRule ^refund_returns/?$ /policy [R=301,L]

# WooCommerce/system, webinars, tools, internal -> home
RewriteRule ^(about-us|home|services)/?$ / [R=301,L]
RewriteRule ^(cart|checkout|my-account|shop)/?$ / [R=301,L]
RewriteRule ^(clinical-trial-portal|fda-assistant|fsmb-guide|fsmbguide|us-visa|visa-masterclass)/?$ / [R=301,L]
RewriteRule ^(past-webinars|post|post-payment-webinar|masterclass-2026-webinar|webinar-guide-call|social-media-internship|team-tasks|testing|whatsapp)/?$ / [R=301,L]

# --- 1d. WooCommerce product URLs -> closest new service (catch-all last) ---
RewriteRule ^product/(.*crash-course.*|.*step-1.*)/?$ /coaching-step1-crash-course [R=301,L]
RewriteRule ^product/(.*nbme.*|.*coaching.*)/?$ /coaching [R=301,L]
RewriteRule ^product/.*eras-cv.*/?$ /match-eras-cv [R=301,L]
RewriteRule ^product/.*lor.*/?$ /match-lor [R=301,L]
RewriteRule ^product/(.*personal-statement.*|psx3|.*ps3x.*|.*psx.*)/?$ /match-ps3x [R=301,L]
RewriteRule ^product/(.*interview.*|.*iv-prep.*)/?$ /match-interview [R=301,L]
RewriteRule ^product/.*catalyst.*/?$ /research-catalyst [R=301,L]
RewriteRule ^product/(.*meta-analysis.*|.*narrative.*|.*review.*|.*abstract.*|.*research.*|.*systematic.*|.*scholar.*)/?$ /research [R=301,L]
RewriteRule ^product/(.*rotation.*|.*usce.*)/?$ /clinical-rotations [R=301,L]
RewriteRule ^product/.*match.*/?$ /match [R=301,L]
RewriteRule ^product/ / [R=301,L]

# --- 2. Serve extensionless URLs from matching .php file ---
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

# --- 3. If someone requests the raw .php, 301 to the clean URL ---
RewriteCond %{THE_REQUEST} \s/(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# --- 4. Redirect newer nested/alternate URLs to HTML-era slugs ---
RewriteRule ^coaching/step-1-crash-course/?$ /coaching-step1-crash-course [R=301,L]
RewriteRule ^coaching-step-1-crash-course/?$ /coaching-step1-crash-course [R=301,L]
RewriteRule ^coaching/step-1-mastery/?$ /coaching-step1-mastery [R=301,L]
RewriteRule ^coaching-step-1-mastery/?$ /coaching-step1-mastery [R=301,L]
RewriteRule ^coaching/step-1-review/?$ /coaching-step1-review [R=301,L]
RewriteRule ^coaching-step-1-review/?$ /coaching-step1-review [R=301,L]
RewriteRule ^coaching/nbme-style-coaching/?$ /coaching-step23-mastery [R=301,L]
RewriteRule ^coaching-nbme-style-coaching/?$ /coaching-step23-mastery [R=301,L]
RewriteRule ^coaching/tutoring/?$ /coaching-tutoring [R=301,L]
RewriteRule ^match/lor-editing/?$ /match-lor [R=301,L]
RewriteRule ^match-lor-editing/?$ /match-lor [R=301,L]
RewriteRule ^match/personal-statement/?$ /match-ps3x [R=301,L]
RewriteRule ^match-personal-statement/?$ /match-ps3x [R=301,L]
RewriteRule ^match/interview-prep/?$ /match-interview [R=301,L]
RewriteRule ^match-interview-prep/?$ /match-interview [R=301,L]
RewriteRule ^match/eras-cv/?$ /match-eras-cv [R=301,L]
RewriteRule ^research/catalyst/?$ /research-catalyst [R=301,L]
RewriteRule ^research/original-research/?$ /research-original [R=301,L]
RewriteRule ^research-original-research/?$ /research-original [R=301,L]
RewriteRule ^research/review-paper/?$ /research-review [R=301,L]
RewriteRule ^research-review-paper/?$ /research-review [R=301,L]
RewriteRule ^research/masterclass/?$ /research-masterclass [R=301,L]
RewriteRule ^research/junior-scientist/?$ /research-junior-scientist [R=301,L]
RewriteRule ^rotations/browse/?$ /clinical-rotations [R=301,L]
RewriteRule ^rotations/(.+?)/?$ /rotation-$1 [R=301,L]
RewriteRule ^case-studies/ahmed/?$ /case-study-ahmed [R=301,L]
RewriteRule ^faq/?$ /qa [R=301,L]
RewriteRule ^privacy-policy/?$ /policy [R=301,L]

ErrorDocument 404 /404.php
