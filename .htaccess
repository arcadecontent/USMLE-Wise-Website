RewriteEngine On
Options -MultiViews
DirectoryIndex index.php

# Serve extensionless URLs from matching .php file
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

ErrorDocument 404 /404.php

# ---- Performance: long-lived caching for static assets (Apache/dev only;
# ---- production nginx sets its own expires — keep behavior equivalent) ----
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# YouTube embeds fail with error 153 when no referrer is sent; the hosting
# default of "same-origin" strips it on cross-origin requests.
<IfModule mod_headers.c>
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
